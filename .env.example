# Environment & URLs
ENV=production
FRONTEND_URL=https://your-frontend-app.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# PostgreSQL Database (Supabase / Neon)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Security Secrets
JWT_SECRET=replace_with_a_secure_jwt_secret_key_32_chars
FERNET_KEY=replace_with_a_valid_fernet_key
INTERNAL_API_KEY=replace_with_internal_secret_key
ADMIN_EMAILS=admin@example.com

# AI Inference (Groq)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/v1/auth/google/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=VedicMuhurtaBot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
